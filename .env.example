# --- OPNsense ---
OPN_URL=https://192.168.1.1
OPN_API_KEY=changeme
OPN_API_SECRET=changeme
# false si certificat auto-signé
OPN_VERIFY_TLS=false

# --- Dashboard ---
PORT=3000
HOST=127.0.0.1
# Protection basic-auth du dashboard (optionnel mais conseillé si HOST != 127.0.0.1)
DASH_USER=
DASH_PASS=

# --- Collecte ---
POLL_INTERVAL_MS=5000
FW_LOG_LIMIT=2000
# Interfaces WAN à surveiller (noms OPNsense, ex: wan). Vide = tout le trafic bloqué
WAN_INTERFACES=
# Réseaux/IP à ignorer (CSV), ex: ton IP publique
IGNORE_SRC=

# 1 = données factices pour tester sans OPNsense
MOCK=0
